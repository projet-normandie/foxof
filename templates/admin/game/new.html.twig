{% extends 'admin/base.html.twig' %}

{% block title %}Nouveau jeu - Admin{% endblock %}

{% block admin_body %}
<div class="row my-4">
    <div class="col-md-8 offset-md-2">
        <div class="card">
            <div class="card-header">
                <h2>Ajouter un jeu</h2>
            </div>
            <div class="card-body">
                {{ form_start(form) }}
                    {{ form_widget(form) }}
                    <div class="d-flex justify-content-between mt-3">
                        <a href="{{ path('admin_game_index') }}" class="btn btn-secondary">Annuler</a>
                        <button type="submit" class="btn btn-primary">Créer</button>
                    </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}
