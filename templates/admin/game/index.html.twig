{% extends 'admin/base.html.twig' %}

{% block title %}Jeux - Admin{% endblock %}

{% block admin_body %}
<div class="row my-4">
    <div class="col-md-12">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h1>Gestion des jeux</h1>
            <a href="{{ path('admin_game_new') }}" class="btn btn-primary">
                Ajouter un jeu
            </a>
        </div>

        {% if pagination.getTotalItemCount > 0 %}
            <div class="card">
                <div class="card-body">
                    <table class="table table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>ID</th>
                                <th>Nom</th>
                                <th>Plateforme</th>
                                <th>Date de fin</th>
                                <th>Recherché</th>
                                <th>Jeu de l'année</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for game in pagination %}
                                <tr>
                                    <td>{{ game.id }}</td>
                                    <td>{{ game.name }}</td>
                                    <td>{{ game.platform.name }}</td>
                                    <td>{{ game.finishedAt ? game.finishedAt|date('d/m/Y') : '-' }}</td>
                                    <td>
                                        {% if game.isSearched %}
                                            <span class="badge bg-success">Oui</span>
                                        {% else %}
                                            <span class="badge bg-secondary">Non</span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        {% if game.isGameOfTheYear %}
                                            <span class="badge bg-warning text-dark">Oui</span>
                                        {% else %}
                                            <span class="badge bg-secondary">Non</span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        <a href="{{ path('admin_game_edit', {id: game.id}) }}" class="btn btn-sm btn-warning">
                                            Modifier
                                        </a>
                                        <form method="post" action="{{ path('admin_game_delete', {id: game.id}) }}" style="display: inline-block;" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce jeu ?');">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ game.id) }}">
                                            <button type="submit" class="btn btn-sm btn-danger">Supprimer</button>
                                        </form>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="navigation mt-3">
                {{ knp_pagination_render(pagination) }}
            </div>

            <p class="text-muted text-center">
                {{ pagination.getTotalItemCount }} jeu(x) au total
            </p>
        {% else %}
            <div class="alert alert-info">
                Aucun jeu trouvé. <a href="{{ path('admin_game_new') }}">Créez-en un maintenant</a>.
            </div>
        {% endif %}
    </div>
</div>
{% endblock %}
