{% extends 'admin/base.html.twig' %}

{% block title %}Plateformes - Admin{% endblock %}

{% block admin_body %}
<div class="row my-4">
    <div class="col-md-12">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h1>Gestion des plateformes</h1>
            <a href="{{ path('admin_platform_new') }}" class="btn btn-primary">
                Ajouter une plateforme
            </a>
        </div>

        {% if pagination.getTotalItemCount > 0 %}
            <div class="card">
                <div class="card-body">
                    <table class="table table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>ID</th>
                                <th>Nom</th>
                                <th>Date de création</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for platform in pagination %}
                                <tr>
                                    <td>{{ platform.id }}</td>
                                    <td>{{ platform.name }}</td>
                                    <td>{{ platform.createdAt|date('d/m/Y H:i') }}</td>
                                    <td>
                                        <a href="{{ path('admin_platform_edit', {id: platform.id}) }}" class="btn btn-sm btn-warning">
                                            Modifier
                                        </a>
                                        <form method="post" action="{{ path('admin_platform_delete', {id: platform.id}) }}" style="display: inline-block;" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette plateforme ?');">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ platform.id) }}">
                                            <button type="submit" class="btn btn-sm btn-danger">Supprimer</button>
                                        </form>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="navigation mt-3">
                {{ knp_pagination_render(pagination) }}
            </div>

            <p class="text-muted text-center">
                {{ pagination.getTotalItemCount }} plateforme(s) au total
            </p>
        {% else %}
            <div class="alert alert-info">
                Aucune plateforme trouvée. <a href="{{ path('admin_platform_new') }}">Créez-en une maintenant</a>.
            </div>
        {% endif %}
    </div>
</div>
{% endblock %}
