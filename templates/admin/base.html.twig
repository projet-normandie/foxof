{% extends 'base.html.twig' %}

{% block body %}
<div class="bg-light border-bottom mb-4">
    <div class="container">
        <nav class="navbar navbar-expand-lg navbar-light">
            <span class="navbar-brand mb-0 h1">Administration</span>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#admin-navbar">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="admin-navbar">
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a class="nav-link {% if app.request.attributes.get('_route') starts with 'admin_platform' %}active{% endif %}"
                           href="{{ path('admin_platform_index') }}">
                            Plateformes
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link {% if app.request.attributes.get('_route') starts with 'admin_game' %}active{% endif %}"
                           href="{{ path('admin_game_index') }}">
                            Jeux
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#">
                            Utilisateurs
                        </a>
                    </li>
                </ul>
            </div>
        </nav>
    </div>
</div>

<div class="container">
    {% block admin_body %}{% endblock %}
</div>
{% endblock %}
